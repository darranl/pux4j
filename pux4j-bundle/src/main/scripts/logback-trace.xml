<!-- Optional logging configuration for the launcher: DEBUG everywhere, plus TRACE for the display
     drivers (every command and data transfer sent to the controller). Use it with
         pux4j <app> -Dlogback.configurationFile=$HOME/applications/pux4j-launcher/bin/logback-trace.xml
     Without it logback's default applies (DEBUG, no TRACE). -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger -- %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="dev.pux4j.ui.driver" level="TRACE"/>

    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
