<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pux4j.ui</groupId>
        <artifactId>pux4j-ui</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pux4j-launcher</artifactId>
    <name>pux4j :: Launcher</name>
    <description>
        Generic launcher that runs any SceneContent app on an EInkBridge. Contains no
        application code and no driver choice: the application and the drivers (emulator or a
        HAT) are whatever is on the module path, so a bundle is just a dependency set.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-fx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Desktop bundle: launcher + the demo apps + the emulator drivers. Used by
             run-emulator.sh. The hardware bundle below is the same shape. -->
        <profile>
            <id>bundle-emulator</id>
            <dependencies>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-emulator</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-demo</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <!-- Hardware bundle for LittleRaspberry: launcher + the demo apps + the 2.13" V4 HAT drivers
             (SSD1680 + GT1151Q) in place of the emulator. Built with the aarch64 JavaFX
             classifier (-Djavafx.platform=linux-aarch64); used by scripts/deploy-eink.sh. -->
        <profile>
            <id>bundle-hat-2in13v4</id>
            <dependencies>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-driver-hat-2in13v4</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-demo</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
