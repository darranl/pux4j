<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pux4j.ui</groupId>
        <artifactId>pux4j-ui</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pux4j-launcher</artifactId>
    <name>pux4j :: Launcher</name>
    <description>
        Generic launcher that runs any SceneContent app on an EInkBridge, or any non-JavaFX
        DriverApp (such as the hardware tests) directly. Contains no
        application code and no driver choice: the application and the drivers (emulator or a
        HAT) are whatever is on the module path, so a bundle is just a dependency set.
    </description>

    <!-- JavaFX comes only from the dependencies declared below, with the platform classifier of
         THIS build. The pux4j modules and the JavaFX poms are resolved through their own poms,
         which Maven evaluates without the -P profiles of this build, so on a laptop they would
         pull the laptop's classifier (x86 jars into a bundle for the Pi); excluding their JavaFX
         avoids that without needing -Djavafx.platform. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.pux4j.ui</groupId>
                <artifactId>pux4j-fx</artifactId>
                <version>${project.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>dev.pux4j.ui</groupId>
                <artifactId>pux4j-demo</artifactId>
                <version>${project.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>dev.pux4j.ui</groupId>
                <artifactId>pux4j-dice-demo</artifactId>
                <version>${project.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>dev.pux4j.ui</groupId>
                <artifactId>pux4j-validation</artifactId>
                <version>${project.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-base</artifactId>
                <version>${javafx.version}</version>
                <classifier>${javafx.platform}</classifier>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-graphics</artifactId>
                <version>${javafx.version}</version>
                <classifier>${javafx.platform}</classifier>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
                <classifier>${javafx.platform}</classifier>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
                <classifier>${javafx.platform}</classifier>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-app-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-fx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Shared by the bundle-hat-* profiles, which only have to name the plugin: the
                     bundle directory target/pux4j (src/main/assembly/bundle.xml). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                    <executions>
                        <execution>
                            <id>hat-bundle</id>
                            <phase>package</phase>
                            <goals><goal>single</goal></goals>
                            <configuration>
                                <descriptors>
                                    <descriptor>src/main/assembly/bundle.xml</descriptor>
                                </descriptors>
                                <finalName>pux4j</finalName>
                                <appendAssemblyId>false</appendAssemblyId>
                                <attach>false</attach>
                                <outputDirectory>${project.build.directory}</outputDirectory>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!-- Empties target/pux4j first, so a bundle never keeps jars of an earlier build
                     (for example the other HAT's driver). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.0</version>
                    <executions>
                        <execution>
                            <id>clean-hat-bundle</id>
                            <phase>prepare-package</phase>
                            <goals><goal>clean</goal></goals>
                            <configuration>
                                <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                <filesets>
                                    <fileset>
                                        <directory>${project.build.directory}/pux4j</directory>
                                    </fileset>
                                </filesets>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Desktop bundle: launcher + the apps + the emulator drivers. On by default, so a plain
             `mvn install` or `mvn package` leaves the runnable bundle in target/run-lib for
             run-emulator.sh. Maven turns an activeByDefault profile off when another profile of
             this pom is activated, so the hardware bundles below do not build it. -->
        <profile>
            <id>bundle-emulator</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>copy-run-lib</id>
                                <phase>package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/run-lib</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-emulator</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-validation</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-demo</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-dice-demo</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <!-- Hardware bundle for the 2.13" V4 HAT: launcher + the apps + the HAT drivers
             (SSD1680 + GT1151Q) in place of the emulator. Built with the aarch64 JavaFX
             classifier (set by the same-named profile in the root pom). `mvn package
             -Pbundle-hat-2in13v4` assembles the ready-to-copy directory target/pux4j. -->
        <profile>
            <id>bundle-hat-2in13v4</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-driver-hat-2in13v4</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-validation</artifactId>
                    <version>${project.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>dev.pux4j.ui</groupId>
                            <artifactId>pux4j-emulator</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-demo</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-dice-demo</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <!-- Hardware bundle for the 2.9" V2 HAT: launcher + the apps + the HAT drivers
             (SSD1675A + ICNT86X) in place of the emulator. Built with the aarch64 JavaFX
             classifier (set by the same-named profile in the root pom). `mvn package
             -Pbundle-hat-2in9v2` assembles the ready-to-copy directory target/pux4j. -->
        <profile>
            <id>bundle-hat-2in9v2</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-driver-hat-2in9v2</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-validation</artifactId>
                    <version>${project.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>dev.pux4j.ui</groupId>
                            <artifactId>pux4j-emulator</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-demo</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-dice-demo</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
