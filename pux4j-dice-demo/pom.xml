<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pux4j.ui</groupId>
        <artifactId>pux4j-ui</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pux4j-dice-demo</artifactId>
    <name>pux4j :: Dice Demo</name>
    <description>Yahtzee-style dice rolling demo for pux4j. Demonstrates touch/click interaction and Canvas rendering on eInk.</description>

    <dependencies>
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-fx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>dist</id>
            <properties>
                <dist.name>pux4j-dice-demo</dist.name>
                <dist.module>dev.pux4j.ui.dice.demo</dist.module>
                <dist.main.class>dev.pux4j.ui.dice.demo.DiceDemoApp</dist.main.class>
                <!-- Override platform to aarch64 so JavaFX classifier deps resolve to Pi-native jars -->
                <javafx.platform>linux-aarch64</javafx.platform>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>dist</id>
                                <phase>package</phase>
                                <goals><goal>single</goal></goals>
                                <configuration>
                                    <finalName>${dist.name}</finalName>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <descriptors>
                                        <descriptor>src/main/assembly/dist.xml</descriptor>
                                    </descriptors>
                                    <filteringDelimiters>
                                        <filteringDelimiter>@</filteringDelimiter>
                                    </filteringDelimiters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
