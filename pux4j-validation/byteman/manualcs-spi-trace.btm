# ByteMan trace rules for ManualCsReplicaTest (Pi4J SPI with manual CS).
# Captures high-level sendCommand / sendCommandData calls and the underlying
# FFMSpi.transfer payload so the trace is directly comparable to raw-spi-trace.

RULE manualcs sendCommand entry
CLASS dev.pux4j.ui.validation.ManualCsReplicaTest
METHOD sendCommand(com.pi4j.io.spi.Spi, com.pi4j.io.gpio.digital.DigitalOutput, com.pi4j.io.gpio.digital.DigitalOutput, byte, byte[])
AT ENTRY
BIND now = java.lang.System.nanoTime();
     thread = java.lang.Thread.currentThread();
     hex = java.util.HexFormat.of().formatHex($5)
IF TRUE
DO traceln("[btm-trace] path=manualcs rule=sendCommand ts=" + now
    + " thread=" + thread.getName() + "#" + thread.getId()
    + " cmd=" + $4
    + " bytes=" + hex)
ENDRULE

RULE manualcs sendCommandData entry
CLASS dev.pux4j.ui.validation.ManualCsReplicaTest
METHOD sendCommandData(com.pi4j.io.spi.Spi, com.pi4j.io.gpio.digital.DigitalOutput, com.pi4j.io.gpio.digital.DigitalOutput, byte, byte[], int, int)
AT ENTRY
BIND now = java.lang.System.nanoTime();
     thread = java.lang.Thread.currentThread();
     slice = java.util.Arrays.copyOfRange($5, $6, $6 + $7);
     hex = java.util.HexFormat.of().formatHex(slice)
IF TRUE
DO traceln("[btm-trace] path=manualcs rule=sendCommandData ts=" + now
    + " thread=" + thread.getName() + "#" + thread.getId()
    + " cmd=" + $4
    + " offset=" + $6
    + " len=" + $7
    + " bytes=" + hex)
ENDRULE

RULE manualcs FFMSpi transfer entry
CLASS com.pi4j.plugin.ffm.providers.spi.FFMSpi
METHOD transfer(byte[], int, byte[], int, int)
AT ENTRY
BIND now = java.lang.System.nanoTime();
     thread = java.lang.Thread.currentThread();
     slice = java.util.Arrays.copyOfRange($1, $2, $2 + $5);
     hex = java.util.HexFormat.of().formatHex(slice)
IF TRUE
DO traceln("[btm-trace] path=manualcs rule=FFMSpi.transfer ts=" + now
    + " thread=" + thread.getName() + "#" + thread.getId()
    + " writeOffset=" + $2
    + " readOffset=" + $4
    + " len=" + $5
    + " bytes=" + hex)
ENDRULE
