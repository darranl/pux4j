# ByteMan trace rules for the raw / direct-ioctl replica test.
# Captures the payload at the Java boundary immediately before the FFM
# downcall so the trace can be compared to the Pi4J path.

RULE raw spiWrite entry
CLASS dev.pux4j.ui.validation.RawSpiReplicaTest
METHOD spiWrite(java.lang.foreign.Arena, int, byte[], int, int)
AT ENTRY
BIND now = java.lang.System.nanoTime();
     thread = java.lang.Thread.currentThread();
     slice = java.util.Arrays.copyOfRange($3, $4, $4 + $5);
     hex = java.util.HexFormat.of().formatHex(slice)
IF TRUE
DO traceln("[btm-trace] path=raw rule=spiWrite ts=" + now
    + " thread=" + thread.getName() + "#" + thread.getId()
    + " fd=" + $2
    + " offset=" + $4
    + " len=" + $5
    + " bytes=" + hex)
ENDRULE

RULE raw sendCommand entry
CLASS dev.pux4j.ui.validation.RawSpiReplicaTest
METHOD sendCommand(java.lang.foreign.Arena, int, com.pi4j.io.gpio.digital.DigitalOutput, com.pi4j.io.gpio.digital.DigitalOutput, byte, byte[])
AT ENTRY
BIND now = java.lang.System.nanoTime();
     thread = java.lang.Thread.currentThread();
     hex = java.util.HexFormat.of().formatHex($6)
IF TRUE
DO traceln("[btm-trace] path=raw rule=sendCommand ts=" + now
    + " thread=" + thread.getName() + "#" + thread.getId()
    + " fd=" + $2
    + " cmd=" + $5
    + " bytes=" + hex)
ENDRULE

RULE raw sendCommandData entry
CLASS dev.pux4j.ui.validation.RawSpiReplicaTest
METHOD sendCommandData(java.lang.foreign.Arena, int, com.pi4j.io.gpio.digital.DigitalOutput, com.pi4j.io.gpio.digital.DigitalOutput, byte, byte[], int, int)
AT ENTRY
BIND now = java.lang.System.nanoTime();
     thread = java.lang.Thread.currentThread();
     slice = java.util.Arrays.copyOfRange($6, $7, $7 + $8);
     hex = java.util.HexFormat.of().formatHex(slice)
IF TRUE
DO traceln("[btm-trace] path=raw rule=sendCommandData ts=" + now
    + " thread=" + thread.getName() + "#" + thread.getId()
    + " fd=" + $2
    + " cmd=" + $5
    + " offset=" + $7
    + " len=" + $8
    + " bytes=" + hex)
ENDRULE
