# ByteMan trace rules for the Pi4J-backed SPI path.
# Logs the high-level FFMSpi transfer slice and the data structure that
# reaches the FFM ioctl wrapper so the trace can be compared against the
# raw-direct path.

RULE pi4j FFMSpi transfer entry
CLASS com.pi4j.plugin.ffm.providers.spi.FFMSpi
METHOD transfer(byte[], int, byte[], int, int)
AT ENTRY
BIND now = java.lang.System.nanoTime();
     thread = java.lang.Thread.currentThread();
     slice = java.util.Arrays.copyOfRange($1, $2, $2 + $5);
     hex = java.util.HexFormat.of().formatHex(slice)
IF TRUE
DO traceln("[btm-trace] path=pi4j rule=FFMSpi.transfer ts=" + now
    + " thread=" + thread.getName() + "#" + thread.getId()
    + " writeOffset=" + $2
    + " readOffset=" + $4
    + " len=" + $5
    + " bytes=" + hex)
ENDRULE

RULE pi4j SpiTransferBuffer to entry
CLASS com.pi4j.plugin.ffm.common.spi.SpiTransferBuffer
METHOD to(java.lang.foreign.MemorySegment, java.lang.foreign.SegmentAllocator)
AT ENTRY
BIND now = java.lang.System.nanoTime();
     thread = java.lang.Thread.currentThread();
     tx = $0.getTxBuffer();
     rx = $0.getRxBuffer();
     txHex = java.util.HexFormat.of().formatHex(tx);
     rxHex = java.util.HexFormat.of().formatHex(rx)
IF TRUE
DO traceln("[btm-trace] path=pi4j rule=SpiTransferBuffer.to ts=" + now
    + " thread=" + thread.getName() + "#" + thread.getId()
    + " len=" + tx.length
    + " tx=" + txHex
    + " rx=" + rxHex)
ENDRULE
