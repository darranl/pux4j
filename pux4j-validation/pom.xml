<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.pux4j.ui</groupId>
        <artifactId>pux4j-ui</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pux4j-validation</artifactId>
    <name>pux4j :: Validation</name>
    <description>Interactive 10-step hardware acceptance test. Runs against any EInkDisplayDriver and TouchDriver via ServiceLoader and config.</description>

    <dependencies>
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-transform</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.pi4j</groupId>
            <artifactId>pi4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pi4j</groupId>
            <artifactId>pi4j-plugin-ffm</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Emulator: runtime scope so it lands in target/run-lib automatically.
             Excluded from hardware distribution assemblies (see dist.xml). -->
        <dependency>
            <groupId>dev.pux4j.ui</groupId>
            <artifactId>pux4j-emulator</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>copy-runtime-deps</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/run-lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dist-hat-2in13v4</id>
            <properties>
                <dist.name>pux4j-validation-hat-2in13v4</dist.name>
                <dist.defaultDisplay>ssd1680</dist.defaultDisplay>
                <dist.defaultTouch>gt1151q</dist.defaultTouch>
                <dist.orientation>LANDSCAPE_INVERTED</dist.orientation>
                <dist.touchArgs>--swap-axes --flip-x --touch-native-width 250 --touch-native-height 122</dist.touchArgs>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-driver-hat-2in13v4</artifactId>
                    <version>${project.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>dist</id>
                                <phase>package</phase>
                                <goals><goal>single</goal></goals>
                                <configuration>
                                    <finalName>${dist.name}</finalName>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <descriptors>
                                        <descriptor>src/main/assembly/dist.xml</descriptor>
                                    </descriptors>
                                    <filteringDelimiters>
                                        <filteringDelimiter>@</filteringDelimiter>
                                    </filteringDelimiters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>dist-hat-2in9v2</id>
            <properties>
                <dist.name>pux4j-validation-hat-2in9v2</dist.name>
                <dist.defaultDisplay>ssd1675a</dist.defaultDisplay>
                <dist.defaultTouch>icnt86x</dist.defaultTouch>
                <dist.orientation>LANDSCAPE</dist.orientation>
                <dist.touchArgs>--flip-x --flip-y --touch-native-width 296 --touch-native-height 128</dist.touchArgs>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>dev.pux4j.ui</groupId>
                    <artifactId>pux4j-driver-hat-2in9v2</artifactId>
                    <version>${project.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>dist</id>
                                <phase>package</phase>
                                <goals><goal>single</goal></goals>
                                <configuration>
                                    <finalName>${dist.name}</finalName>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <descriptors>
                                        <descriptor>src/main/assembly/dist.xml</descriptor>
                                    </descriptors>
                                    <filteringDelimiters>
                                        <filteringDelimiter>@</filteringDelimiter>
                                    </filteringDelimiters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
