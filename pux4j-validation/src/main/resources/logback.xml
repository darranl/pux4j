<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Show driver internals (partialInit, full-refresh frames, etc.) during
         the partial-refresh investigation so log output correlates with the
         smoke test phases. -->
    <logger name="dev.pux4j.ui.core.internal.ssd1675a" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
